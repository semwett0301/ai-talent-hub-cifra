# The only service exposed to the host. Serves the built React SPA as static
# files, proxies /api to the backend (internal, closed network) and ${LOGS_PREFIX}
# to Dozzle (which does its own login).
#
# .template: processed by the nginx image's built-in docker-entrypoint envsubst
# step at container start, substituting ${SOURCES_API_PREFIX} / ${NEWS_API_PREFIX} /
# ${NPA_API_PREFIX} (and any other env var actually set in the container) into
# /etc/nginx/conf.d/default.conf. nginx's
# own $-variables ($host, $remote_addr, $scheme, $uri, $1, ...) are left alone —
# envsubst only touches names that exist in the environment.

# WebSocket-style upgrade passthrough (Dozzle streams over SSE/WS).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Forwarded to every proxied backend (inherited by the /api locations below).
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Docker's embedded DNS, so the upstream is re-resolved at request time
    # instead of being pinned to one replica's IP at startup.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location ~ ^${SOURCES_API_PREFIX}(?:/(.*))?$ {
        set $sources_backend http://source_service:8000;

        rewrite ^${SOURCES_API_PREFIX}(?:/(.*))?$ /$1 break;
        proxy_pass $sources_backend;
    }

    location ~ ^${NEWS_API_PREFIX}(?:/(.*))?$ {
        set $news_backend http://news_service:8000;

        rewrite ^${NEWS_API_PREFIX}(?:/(.*))?$ /$1 break;
        proxy_pass $news_backend;
    }

    location ~ ^${NPA_API_PREFIX}(?:/(.*))?$ {
        set $npa_backend http://npa_service:8000;

        rewrite ^${NPA_API_PREFIX}(?:/(.*))?$ /$1 break;
        proxy_pass $npa_backend;
    }

    # Container logs UI (Dozzle, DOZZLE_BASE=${LOGS_PREFIX}): prefix kept, auth is
    # Dozzle's own; streaming-friendly (no buffering, long read timeout, upgrade passthrough).
    location = ${LOGS_PREFIX} {
        return 301 ${LOGS_PREFIX}/;
    }

    location ${LOGS_PREFIX}/ {
        set $dozzle_backend http://dozzle:8080;
        proxy_pass $dozzle_backend;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering    off;
        proxy_read_timeout 1h;
    }

    # SPA: serve static assets, fall back to index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
