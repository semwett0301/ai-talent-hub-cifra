# Single source of truth for every environment variable in this project —
# backend, frontend, nginx, Docker Compose, Terraform and the deploy workflow.
# There is no other .env.example / tfvars anywhere in the repo.
#
#   cp .env.example .env    then fill in the blanks
#
# .env is gitignored and is NOT rsynced to the server — the deploy job writes a
# minimal production .env there from GitHub Secrets (README.md -> "Server .env").
# What each variable means, and which of them are secrets: README.md ->
# "Environment variables".

# ---- App (backend) ----
APP_NAME="AI Analytical Center"
ENVIRONMENT=local
DEBUG=true

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cifra
POSTGRES_PASSWORD=cifra
POSTGRES_DB=cifra
# DATABASE_URL=postgresql+asyncpg://cifra:cifra@localhost:5432/cifra

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
NEWS_EXCHANGE=news

# ---- source_service scheduler (fallback poll period for pull sources without their own) ----
SOURCE_POLL_INTERVAL_SECONDS=300

# ---- news_service consumer (queue bound to NEWS_EXCHANGE; batch flushes on either limit) ----
NEWS_QUEUE=news.raw
NEWS_BATCH_SIZE=100
NEWS_BATCH_INTERVAL_SECONDS=60
NEWS_REQUEUE_ON_STORE_ERROR=true

# ---- news_service -> npa_service (internal base URL the escalation endpoint posts acts to) ----
NPA_SERVICE_URL=http://localhost:8002

# ---- Edge routing (nginx location + FastAPI root_path + SPA bundle, one per service) ----
SOURCES_API_PREFIX=/api/sources
NEWS_API_PREFIX=/api/news
NPA_API_PREFIX=/api/npa

# ---- Logs (Dozzle behind nginx at LOGS_PREFIX; deploy writes dozzle/users.yml from these) ----
LOGS_PREFIX=/logs
LOGS_USER=admin
LOGS_PASSWORD=

# ---- Telegram (MTProto user session; empty = collector disabled) ----
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ---- Web crawler (WEB sources) ----
# LLM is used only for ambiguous publication dates and listing-page relevance.
# Without a token the deterministic Crawl4AI/HTML path remains available.
WEB_CRAWL_DAYS=3
WEB_CRAWL_MAX_ARTICLES=50
WEB_CRAWL_LLM_ENABLED=true
# Any other crawl knob (backend/common/common/core/settings/templates/web_crawl.py) can be
# overridden as WEB_CRAWL_<FIELD>, e.g. WEB_CRAWL_ARTICLE_BATCH_SIZE=10. Defaults are fine.
NEWS_AGENT_MODEL=deepseek/deepseek-v4-flash
NEWS_LLM_PROVIDER=
NEWS_LLM_API_TOKEN=
NEWS_LLM_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter slug without the ``openrouter/`` prefix, e.g. deepinfra/fp8.
# Empty means NEWS_AGENT_MODEL is used for backwards compatibility.
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- Terraform: DigitalOcean provider (also used by the DigitalOcean MCP in .mcp.json) ----
DIGITALOCEAN_TOKEN=

# ---- Terraform: remote state (Spaces access key for the cifra-tfstate bucket, ams3) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Terraform: inputs (TF_VAR_* -> terraform/variables.tf) ----
TF_VAR_SSH_PUBLIC_KEY=
TF_VAR_APP_NAME=cifra
TF_VAR_DEPLOY_USER=deploy
TF_VAR_SERVER_NAME=cifra-prod
TF_VAR_REGION=ams3
TF_VAR_SIZE=s-2vcpu-4gb
TF_VAR_IMAGE=ubuntu-24-04-x64

# ---- Deploy over SSH ----
SSH_PRIVATE_KEY=
