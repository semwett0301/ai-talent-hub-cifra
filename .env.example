# Single source of truth for every environment variable in this project —
# backend, frontend, nginx, Docker Compose, Terraform and the deploy workflow.
# There is no other .env.example / tfvars anywhere in the repo.
#
#   cp .env.example .env    then fill in the blanks
#
# .env is gitignored and is NOT rsynced to the server — create it there once by
# hand. What each variable means, and which of them are secrets that go to
# GitHub Actions Secrets: README.md -> "Environment variables".

# ---- App (backend) ----
APP_NAME="AI Analytical Center"
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=change-me-in-production

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cifra
POSTGRES_PASSWORD=cifra
POSTGRES_DB=cifra
# DATABASE_URL=postgresql+asyncpg://cifra:cifra@localhost:5432/cifra

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
NEWS_EXCHANGE=news

# ---- Edge routing (nginx location + FastAPI root_path) ----
SOURCES_API_PREFIX=/api/sources

# ---- Scaling (one replica while pull scheduling is in-process) ----
SOURCE_SERVICE_REPLICAS=1

# ---- Frontend (build time; ships to the browser, never secrets) ----
VITE_API_BASE_URL=/api

# ---- Telegram (MTProto user session; empty = collector disabled) ----
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ---- Web crawler (WEB sources) ----
# LLM is used only for ambiguous publication dates and listing-page relevance.
# Without a token the deterministic Crawl4AI/HTML path remains available.
WEB_CRAWL_DAYS=3
WEB_CRAWL_MAX_ARTICLES=50
WEB_CRAWL_LLM_ENABLED=true
NEWS_AGENT_MODEL=deepseek/deepseek-v4-flash
NEWS_LLM_PROVIDER=
NEWS_LLM_API_TOKEN=
NEWS_LLM_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter slug without the ``openrouter/`` prefix, e.g. deepinfra/fp8.
# Empty means NEWS_AGENT_MODEL is used for backwards compatibility.
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- Terraform: provider + remote state ----
TWC_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Terraform: inputs (TF_VAR_* -> terraform/variables.tf) ----
TF_VAR_SSH_PUBLIC_KEY=
TF_VAR_APP_NAME=cifra
TF_VAR_DEPLOY_USER=deploy
TF_VAR_SERVER_NAME=cifra-prod
TF_VAR_LOCATION=ru-1
TF_VAR_AVAILABILITY_ZONE=spb-3
TF_VAR_OS_NAME=ubuntu
TF_VAR_OS_VERSION=24.04
TF_VAR_CPU=2
TF_VAR_RAM_MB=4096
TF_VAR_DISK_MB=40960

# ---- Deploy over SSH ----
SSH_PRIVATE_KEY=
