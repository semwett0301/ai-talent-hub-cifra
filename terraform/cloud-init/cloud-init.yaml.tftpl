#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
timezone: Europe/Moscow

package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl
  - gnupg

users:
  - default
  - name: ${deploy_user}
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}

# Free the apt lock before the packages module (apt-daily races corrupt the cache).
bootcmd:
  - |
    set -ux
    systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
    systemctl stop apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
    for _ in $(seq 1 60); do
      fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock >/dev/null 2>&1 || break
      sleep 2
    done

runcmd:
  # Deploy dir first (rsync target; deploy user can't mkdir under /opt) — never abort before it.
  - [ install, -d, -o, "${deploy_user}", -g, "${deploy_user}", "${app_dir}" ]

  # Install Docker + compose plugin (the plain Ubuntu image ships without Docker).
  - |
    set -ux
    curl -fsSL https://get.docker.com | sh || true
    systemctl enable --now docker || true
    usermod -aG docker "${deploy_user}" || true

  - [ touch, /var/lib/cloud/bootstrap-complete ]

final_message: "cloud-init finished. App dir ready: ${app_dir}"
