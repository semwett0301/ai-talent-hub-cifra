# Backend config for local `terraform init -backend-config=backend.hcl`.
# CI generates the equivalent from secrets/vars (see .github/workflows/deploy.yml).
# namespace + region come from OCI Object Storage (plans/oci-console-setup.md §3).
region = "eu-frankfurt-1"
endpoints = {
  s3 = "https://<namespace>.compat.objectstorage.eu-frankfurt-1.oraclecloud.com"
}
