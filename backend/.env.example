# ---- App ----
APP_NAME="AI Analytical Center"
ENVIRONMENT=local           # local | staging | production
DEBUG=true
SECRET_KEY=change-me-in-production

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cifra
POSTGRES_PASSWORD=cifra
POSTGRES_DB=cifra
# Async URL is derived from the parts above in config.py; override if needed:
# DATABASE_URL=postgresql+asyncpg://cifra:cifra@localhost:5432/cifra

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
NEWS_EXCHANGE=news

# ---- Telegram (MTProto user session; leave empty to disable the collector) ----
# Obtain api_id/api_hash at https://my.telegram.org; generate the session string
# once from an authorized user account with kurigram (pyrogram.Client(...,
# in_memory=True) then await client.export_session_string()). Not interchangeable
# with a Telethon StringSession — the two libraries' formats differ.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
