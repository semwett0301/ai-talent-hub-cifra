# ---- App ----
APP_NAME="AI Analytical Center"
ENVIRONMENT=local           # local | staging | production
DEBUG=true
SECRET_KEY=change-me-in-production
# Public prefix the edge proxy mounts the service under (nginx strips it).
# Empty for direct local runs; compose sets it per service (e.g. /api/sources).
API_ROOT_PATH=

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cifra
POSTGRES_PASSWORD=cifra
POSTGRES_DB=cifra
# Async URL is derived from the parts above in config.py; override if needed:
# DATABASE_URL=postgresql+asyncpg://cifra:cifra@localhost:5432/cifra

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
NEWS_EXCHANGE=news
